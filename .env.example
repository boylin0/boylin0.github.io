# Copy to .env.local and fill in. .env.local is git-ignored.
# Only variables prefixed with VITE_ reach the browser; nothing here does.

# Classic personal access token with the repo and read:user scopes, used by `pnpm stats`.
# Create one at https://github.com/settings/tokens/new?scopes=repo,read:user
# Fine-grained tokens are not supported.
STATS_TOKEN=
